# Optional: Set to 'true' (or any truthy value) to enable CI mode settings in playwright.config.ts.
# When CI is set:
# - forbidOnly is set to true (fails build if test.only is left in code).
# - retries are increased to 2 (defaults to 0 locally).
# - workers are limited to 1 (defaults to undefined/parallel locally) to ensure stability in CI environments.
CI=true
