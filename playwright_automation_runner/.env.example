# .env.example
# Template for environment variables for the Playwright Automation Runner.
# Copy this file to .env to override defaults.

# ==============================================
# Environment Variables
# ==============================================

# Note: Initially, no custom environment variables are strictly required for local execution.
# However, the Playwright configuration (playwright.config.ts) respects specific system variables.

# CI (Continuous Integration)
# Setting this variable (usually done automatically by CI providers) affects:
# - retries (Increases retries on CI)
# - workers (Reduces parallel workers on CI for stability)
# - forbidOnly (Prevents committing .only tests)
# CI=true

# ==============================================
# Playwright Configuration Usage Notes
# ==============================================
# The configuration is defined in `playwright.config.ts`.
#
# Default Settings:
# - Test Directory: ./tests
# - Base URL: http://localhost:3000
# - Reporter: html
#
# Running Tests:
# - Run all tests:    npm test
# - Run with UI:      npm run test:ui
# - View Report:      npm run show-report
